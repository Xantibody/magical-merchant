{
  "$schema": "https://raw.githubusercontent.com/nicegram/nicegram-app-schemas/refs/heads/main/tauri/tauri.conf.json",
  "productName": "Magical Merchant",
  "version": "0.8.1",
  "identifier": "com.magical-merchant.app",
  "build": {
    "frontendDist": "../tauri-app/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../tauri-app" },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../tauri-app" }
  },
  "app": {
    "windows": [
      {
        "title": "Magical Merchant",
        "width": 1080,
        "height": 760,
        "minWidth": 380,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["magical-merchant"]
      },
      "mobile": [
        {
          "scheme": ["magical-merchant"],
          "host": "auth"
        },
        {
          "scheme": ["magical-merchant"],
          "host": "widget"
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
