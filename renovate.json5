{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":semanticCommitTypeAll(chore)"],

  // Mend の App は All repositories でインストールすると silent (dryRun=lookup) で
  // 起動し、PR も dependency dashboard も作らない。ここで明示的に打ち消す
  mode: "full",

  timezone: "Asia/Tokyo",
  schedule: ["before 6am on monday"],
  labels: ["dependencies"],

  // nix manager は beta で既定が無効。flake.nix の入力を追うのに要る
  nix: { enabled: true },

  packageRules: [
    {
      description: "入力は 4 つとも branch 追従なので、個別に出すと毎週 digest bump が 4 本並ぶ",
      matchManagers: ["nix"],
      groupName: "flake inputs",
    },
    {
      description: [
        "tauri-app の JS 依存。pnpm-lock.yaml が動くと nix/package.nix の pnpmDeps.hash が必ず腐り、",
        "取り直しは手作業になる (postUpgradeTasks は Mend hosted では使えない)。",
        "1 PR にまとめて、その手間を更新ごとではなく週 1 回に閉じ込める",
      ],
      matchManagers: ["npm"],
      matchFileNames: ["tauri-app/package.json"],
      groupName: "tauri-app dependencies",
      prBodyNotes: [
        "この PR は `nix-package` が赤のままではマージできない。`nix/package.nix` の `pnpmDeps.hash` を `lib.fakeHash` に置き換えて `nix build .#pnpm-deps` を回し、エラーの `got:` の値を書き戻すこと。",
      ],
    },
    {
      description: [
        "@tauri-apps/api と cli は npm 側が先に出る。crate の tauri と minor が",
        "揃っていないと cargo-tauri が「version mismatched Tauri packages」で",
        "ビルドを止めるので、範囲は ~2.10 に絞り patch だけ流す。crate が 2.11 に",
        "上がったら手で範囲を動かす",
      ],
      matchManagers: ["npm"],
      matchPackageNames: ["@tauri-apps/api", "@tauri-apps/cli"],
      matchUpdateTypes: ["minor", "major"],
      enabled: false,
    },
    {
      description: [
        "playwright の版はブラウザ本体のリビジョンと 1 対 1 で、そのブラウザは",
        "flake.lock の nixpkgs が持つ playwright-driver から来る (PLAYWRIGHT_BROWSERS_PATH)。",
        "npm 側だけ上げると要求リビジョンがずれ、vitest の browser mode が",
        "「Executable doesn't exist」で全部落ちる。nixpkgs が動いた時に手で合わせる",
      ],
      matchManagers: ["npm"],
      matchPackageNames: ["playwright"],
      enabled: false,
    },
    {
      description: "workers は nix ビルドに入らないので tauri-app と分ける",
      matchManagers: ["npm"],
      matchFileNames: ["workers/package.json"],
      groupName: "workers dependencies",
    },
    {
      description: "ワークスペース 3 crate ぶんが個別に出ると多い。major は config:recommended が切り出す",
      matchManagers: ["cargo"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "cargo dependencies",
    },
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
    },
  ],
}
