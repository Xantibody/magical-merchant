# AIDEV-NOTE: the Tauri CLI looks for tauri.conf.json below the cwd only; the crate is a sibling, so every `pnpm tauri` is told where it is
export TAURI_APP_PATH := source_directory() / ".." / "backend"
# AIDEV-NOTE: Gradle's generated BuildTask runs `pnpm tauri android android-studio-script` in the crate directory, which has no package.json; pnpm reads its --dir from here
export PNPM_CONFIG_DIR := source_directory() / ".." / "frontend"

[private]
default:
  @just --list

# tauri CLI は package.json のあるフロントエンドに入っている
[private]
deps:
  pnpm --dir ../frontend install

# gen/android は Tauri 既定のランチャーアイコンを持って生成される。
# 入れ直さないと配信 APK が Tauri のロゴのままになるので、init と一続きにする。

# Android プロジェクト (gen/android) を最初に作る
init: deps
  pnpm --dir ../frontend tauri android init
  just --justfile {{source_directory()}}/../justfile frontend::icons
  just --justfile {{source_file()}} setup

# gen/android を作り直すたびに当て直す生成物パッチ (どちらも冪等):
#   - rustls-platform-verifier の Kotlin 側を app モジュールに繋ぐ。reqwest が
#     Android のトラストストアに届くのに要る (tls/README.md)
#   - ホーム画面ウィジェットのソースを入れ、receiver を manifest に登録する
#     (widget/README.md)
# 署名だけは keystore.properties を要求して失敗しうるので sign-setup に分けてある。

# gen/android に TLS とウィジェットのパッチを当て直す (冪等)
setup:
  go run tls/apply-tls.go
  go run widget/apply-widget.go

# リリース署名の設定を、生成された build.gradle.kts に注入する (冪等)。
# keystore.properties が無いと失敗するので setup とは別建て。
# キーストアの初回準備は signing/README.md を参照。

# リリース署名の設定を build.gradle.kts に注入する (冪等)
sign-setup:
  go run signing/apply-signing.go

dev: deps
  pnpm --dir ../frontend tauri android dev

# デバッグ APK を建てる
build-debug: setup
  pnpm --dir ../frontend tauri android build --debug --target aarch64

# arm64 のみ: x86 系はエミュレータ専用で実機には要らず、universal だと
# 4 ABI ぶんの .so で APK が 52MB まで膨らむ。

# 署名済みリリース APK を建てる (keystore.properties が要る)
build-release: setup sign-setup
  pnpm --dir ../frontend tauri android build --apk --target aarch64

# --target aarch64 でも Tauri は出力名を universal のままにする。

# 建てて USB 接続の Android 端末に入れる (release で署名済み版)
install variant="debug":
  just --justfile {{source_file()}} build-{{variant}}
  adb install -r ../backend/gen/android/app/build/outputs/apk/universal/{{variant}}/app-universal-{{variant}}.apk
