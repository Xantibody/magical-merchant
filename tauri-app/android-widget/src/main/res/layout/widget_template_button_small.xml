<?xml version="1.0" encoding="utf-8"?>
<!-- 4b — one template as a button (1x1).
     The name's initial on an accent square and the name along the bottom
     edge. The spacers are FrameLayouts:
     a bare View is not a class RemoteViews will inflate. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_template_button_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bar_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_template_button_glyph"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_glyph_bg"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_on_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_template_button_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="12.5sp"
        android:textStyle="bold" />
</LinearLayout>
