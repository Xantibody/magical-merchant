<?xml version="1.0" encoding="utf-8"?>
<!-- 2b (top bar) — "new note" (4x1).
     Same geometry as the capture bar so the two read as one family: label
     column, rail, placeholder, trailing action. The clock is replaced by the
     bar's title, and the send square by a plus. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_notes_new_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bar_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="@string/widget_notes_label"
            android:textColor="@color/widget_muted"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:text="@string/widget_notes_new_title"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_rail"
        android:contentDescription="@null" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_notes_new_placeholder"
        android:textColor="@color/widget_muted"
        android:textSize="14sp" />

    <ImageView
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_action_bg"
        android:contentDescription="@string/widget_notes_new_widget_label"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_plus" />
</LinearLayout>
