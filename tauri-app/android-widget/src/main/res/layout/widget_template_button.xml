<?xml version="1.0" encoding="utf-8"?>
<!-- 4a — one template as a button (2x1).
     Name and today's title on the left; the 42dp + square on the right says a
     tap makes a note. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_template_button_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bar_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_template_button_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_template_button_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_faint"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="10dp">

        <ImageView
            android:id="@+id/widget_template_button_create"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_action_bg"
            android:contentDescription="@string/widget_template_action_create"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_plus" />
    </FrameLayout>
</LinearLayout>
