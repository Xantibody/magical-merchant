<?xml version="1.0" encoding="utf-8"?>
<!--
    Default = English; Japanese lives in values-ja/.

    The app picks its language in Settings and keeps the choice inside the
    WebView (lib/i18n.ts). A widget process never starts the WebView, so that
    setting is unreachable from here and the split has to be the platform's:
    the launcher resolves these against the device locale, which also covers the
    <receiver> labels in the widget picker (android-widget/apply-widget.go).
    Wording follows the app's own English table where it already has one.

    Keep this file and values-ja/ at the same set of names — a name present in
    only one of them falls back silently and puts an English string into a
    Japanese widget.
-->
<resources>
    <!-- The app calls this surface Scrawl; only the route and the code still say
         scrawl, so the resource name stays and the value follows the UI. -->
    <string name="widget_scrawl_label">SCRAWL</string>
    <string name="widget_capture_placeholder">What\'s on your mind?</string>
    <string name="widget_capture_continue">Keep going…</string>
    <string name="widget_capture_bar_label">Scrawl</string>
    <string name="widget_capture_bar_description">Writes to Scrawl from the home screen</string>

    <string name="quick_capture_send">Send</string>
    <string name="quick_capture_failed">Could not save</string>

    <string name="widget_notes_label">NOTE</string>
    <string name="widget_notes_new_title">New Note</string>
    <string name="widget_notes_new_placeholder">Tap to start writing</string>
    <string name="widget_notes_new_widget_label">New Note</string>
    <string name="widget_notes_new_description">Opens a new Note, ready to write in</string>
    <string name="widget_notes_list_label">Recent Notes</string>
    <string name="widget_notes_list_description">Opens one of your recent Notes</string>
    <string name="widget_notes_empty">No Notes yet</string>

    <string name="widget_templates_label">TEMPLATES</string>
    <string name="widget_templates_app">Magical Merchant</string>
    <string name="widget_templates_widget_label">Templates</string>
    <string name="widget_templates_description">Makes a Note from a template</string>
    <string name="widget_templates_empty">Make a template</string>
</resources>
