<?xml version="1.0" encoding="utf-8"?>
<!-- The second and later template tiles. The fill stays the surface; the border
     alone says it can be tapped. Same 14dp radius as the filled tile. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_on_accent" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_border" />
    <corners android:radius="14dp" />
</shape>
