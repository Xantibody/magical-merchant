<?xml version="1.0" encoding="utf-8"?>
<!-- The trailing square once today's note exists: the surface colour with a 1dp
     border instead of the accent fill, so "open" reads quieter than "create".
     Same 12dp radius as widget_action_bg. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_border" />
    <corners android:radius="12dp" />
</shape>
