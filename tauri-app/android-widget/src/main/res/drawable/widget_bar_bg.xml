<?xml version="1.0" encoding="utf-8"?>
<!-- Widget surface: 24dp radius, 1dp border. The radius is fixed rather than
     @android:dimen/system_app_widget_background_radius because the handoff
     pins it; launchers on API 31+ clip to their own radius anyway. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_border" />
    <corners android:radius="24dp" />
</shape>
