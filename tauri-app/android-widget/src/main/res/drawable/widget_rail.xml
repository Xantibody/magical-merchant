<?xml version="1.0" encoding="utf-8"?>
<!-- The timeline rail from the app: a 2dp vertical line with a 10dp dot at the
     entry position. android:width/height on <item> needs API 23; minSdk is 24. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="2dp"
        android:gravity="center_horizontal|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_rail" />
        </shape>
    </item>
    <item
        android:width="10dp"
        android:height="10dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/widget_accent" />
        </shape>
    </item>
</layer-list>
