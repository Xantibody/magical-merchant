<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis="0": the bar is static and TextClock ticks on its own,
     so there is nothing for the system to poll. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_capture_bar_description"
    android:initialLayout="@layout/widget_capture_bar"
    android:minHeight="40dp"
    android:minWidth="250dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_capture_bar"
    android:resizeMode="horizontal"
    android:targetCellHeight="1"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
