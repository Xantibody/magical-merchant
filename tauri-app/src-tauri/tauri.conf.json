{
  "$schema": "https://raw.githubusercontent.com/nicegram/nicegram-app-schemas/refs/heads/main/tauri/tauri.conf.json",
  "productName": "Magical Merchant",
  "version": "0.3.0",
  "identifier": "com.magical-merchant.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Magical Merchant",
        "width": 1080,
        "height": 760,
        "minWidth": 380,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["magical-merchant"]
      },
      "mobile": [
        {
          "scheme": ["magical-merchant"],
          "host": "auth"
        },
        {
          "scheme": ["magical-merchant"],
          "host": "widget"
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
